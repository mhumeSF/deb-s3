#!/usr/bin/env bash
#MISE description="Build Go Linux binaries, Debian packages, and checksums"
set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"
cd "${repository_root}"

if [[ -z "${VERSION:-}" ]]; then
    if [[ "${GITHUB_REF_TYPE:-}" == "tag" && -n "${GITHUB_REF_NAME:-}" ]]; then
        VERSION="${GITHUB_REF_NAME}"
    else
        VERSION="$(git describe --tags --always)"
    fi
fi
VERSION="${VERSION#v}"
if [[ ! "${VERSION}" =~ ^[0-9] ]]; then
    VERSION="0.0.0~${VERSION}"
fi
export VERSION

if [[ -z "${SOURCE_DATE_EPOCH:-}" ]]; then
    SOURCE_DATE_EPOCH="$(git log -1 --format=%ct)"
fi
export SOURCE_DATE_EPOCH

output_directory="${OUTPUT_DIR:-dist}"
mkdir -p "${output_directory}"
output_directory="$(cd "${output_directory}" && pwd)"

ldflags="-s -w -X github.com/mhumesf/deb-s3/internal/buildinfo.Version=${VERSION}"
for architecture in amd64 arm64; do
    binary="${output_directory}/deb-s3_linux_${architecture}"
    CGO_ENABLED=0 GOOS=linux GOARCH="${architecture}" \
        go build -trimpath -buildvcs=false -ldflags="${ldflags}" -o "${binary}" ./cmd/deb-s3

    export GOARCH="${architecture}"
    export NFPM_BINARY="${binary}"
    nfpm package \
        --config .nfpm/deb-s3-go.yml \
        --packager deb \
        --target "${output_directory}/deb-s3_${VERSION}_${architecture}.deb"
done

artifact_names=(
    "deb-s3_linux_amd64"
    "deb-s3_linux_arm64"
    "deb-s3_${VERSION}_amd64.deb"
    "deb-s3_${VERSION}_arm64.deb"
)
if command -v sha256sum >/dev/null 2>&1; then
    (cd "${output_directory}" && sha256sum "${artifact_names[@]}") >"${output_directory}/checksums.txt"
else
    (cd "${output_directory}" && shasum -a 256 "${artifact_names[@]}") >"${output_directory}/checksums.txt"
fi
